<Window
    x:Class="SekaniUI.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SekaniUI.Controls"
    xmlns:converters="using:SekaniUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorCore="using:Sekani.EditorCore"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="using:SekaniUI.ViewModels"
    Title="SekaniUI"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />
    </Window.Resources>

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>


    <Grid RowDefinitions="*,Auto">
        <controls:EditorView
            DocumentView="{Binding ActiveDocumentView}"
            IsVisible="{Binding ActiveDocumentView, Converter={x:Static ObjectConverters.IsNotNull}}"
            Mode="{Binding Mode, Mode=TwoWay}"
            MotionCountBuffer="{Binding MotionCountBuffer, Mode=TwoWay}" />
        <controls:EmptyEditorView IsVisible="{Binding ActiveDocumentView, Converter={x:Static ObjectConverters.IsNull}}" Mode="{Binding Mode, Mode=TwoWay}" />
        <shadui:ToastHost Manager="{Binding ShadToastManager}" />

        <!--  Small Input Prompt  -->
        <controls:SmallInputPrompt IsVisible="{Binding SmallInputPromptContext, Converter={x:Static, ObjectConverters.IsNotNull}}" />

        <!--  Big Input Prompt  -->
        <controls:BigInputPrompt IsVisible="{Binding BigInputPromptContext, Converter={x:Static, ObjectConverters.IsNotNull}}" />

        <!--  Bottom Bar  -->
        <StackPanel
            Grid.Row="1"
            Height="30"
            Orientation="Horizontal"
            Spacing="20">
            <StackPanel.Background>
                <SolidColorBrush Color="{DynamicResource BackgroundColor}" />
            </StackPanel.Background>
            <TextBlock FontSize="15" Text="{Binding Mode}" />
            <TextBlock Text="{Binding MotionCountBuffer}" />
        </StackPanel>
    </Grid>
</Window>

